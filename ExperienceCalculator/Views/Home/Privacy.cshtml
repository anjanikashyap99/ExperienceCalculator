@{
    ViewData["Title"] = "Privacy Policy - Experience Calculator";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="fw-bold mb-4">Privacy Policy</h1>
            <p class="text-muted small">Last updated: @DateTime.Now.ToString("MMMM yyyy")</p>

            <h2 class="h5 fw-bold mt-4">No Data Collection</h2>
            <p class="text-muted">
                Experience Calculator does not require you to create an account, log in, or provide any
                personal information to use the tool. All employment dates you enter are processed entirely
                within your own browser and are never sent to, or stored on, any server.
            </p>

            <h2 class="h5 fw-bold mt-4">No Cookies for Tracking</h2>
            <p class="text-muted">
                We do not use tracking cookies to collect personal data about you. Any data used to make the
                calculator function stays local to your browser session.
            </p>

            <h2 class="h5 fw-bold mt-4">Third-Party Sharing Links</h2>
            <p class="text-muted">
                When you use the WhatsApp or LinkedIn share buttons, you are redirected to those platforms'
                own websites, which have their own separate privacy policies. We recommend reviewing their
                policies if you have concerns about how they handle shared content.
            </p>

            <h2 class="h5 fw-bold mt-4">Changes to This Policy</h2>
            <p class="text-muted mb-0">
                We may update this privacy policy from time to time. Any changes will be reflected on this
                page with an updated revision date.
            </p>
        </div>
    </div>
</section>