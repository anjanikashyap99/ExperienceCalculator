@{
    ViewData["Title"] = "About Us - Experience Calculator";
    ViewData["MetaDescription"] = "Learn about Experience Calculator, a free tool built to help professionals accurately calculate their total work experience across multiple jobs.";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="fw-bold mb-4">About Experience Calculator</h1>

            <p class="text-muted">
                Experience Calculator is a free, easy-to-use tool designed to help professionals accurately
                calculate their total work experience across one or more jobs. Whether you're updating your
                resume, preparing for a job interview, filling out a LinkedIn profile, or simply curious about
                how many years and months you've spent in your career, our calculator gives you an instant,
                reliable answer.
            </p>

            <h2 class="h4 fw-bold mt-4">Why We Built This</h2>
            <p class="text-muted">
                Manually adding up work experience across multiple jobs — especially when periods overlap —
                can be confusing and error-prone. We built Experience Calculator to remove that guesswork.
                Our tool automatically detects overlapping employment periods and merges them so your total
                experience is never double-counted.
            </p>

            <h2 class="h4 fw-bold mt-4">Who Can Use It</h2>
            <p class="text-muted">
                This calculator is useful for job seekers preparing resumes, HR professionals verifying
                candidate experience, freelancers tracking multiple concurrent projects, and anyone who wants
                a quick, accurate summary of their professional experience.
            </p>

            <h2 class="h4 fw-bold mt-4">Privacy First</h2>
            <p class="text-muted mb-0">
                Experience Calculator works entirely in your browser. We don't require sign-up, we don't store
                your employment data on any server, and nothing you enter is shared with anyone.
            </p>
        </div>
    </div>
</section>