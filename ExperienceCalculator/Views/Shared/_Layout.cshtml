<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <title>@ViewData["Title"] - Experience Calculator</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "Free online work experience calculator. Add multiple job periods and instantly calculate your total years and months of professional experience.")" />
    <link rel="canonical" href="@($"https://www.yourdomain.com{Context.Request.Path}")" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="theme-color" content="#4f46e5" />

    <!-- Open Graph (Facebook/LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"] - Experience Calculator" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Free online work experience calculator. Calculate your total professional experience in seconds.")" />
    <meta property="og:url" content="@($"https://www.yourdomain.com{Context.Request.Path}")" />
    <meta property="og:site_name" content="Experience Calculator" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@ViewData["Title"] - Experience Calculator" />
    <meta name="twitter:description" content="@(ViewData["MetaDescription"] ?? "Free online work experience calculator. Calculate your total professional experience in seconds.")" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-clock-history text-primary"></i> Experience Calculator
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#calculator">Calculator</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#how-it-works">How It Works</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#faq">FAQ</a>
                        </li>
                        <li><a asp-controller="Home" asp-action="About" class="text-secondary text-decoration-none">About</a></li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-primary rounded-pill px-3" href="#calculator">Calculate Now</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="fw-bold">Experience Calculator</h5>
                    <p class="text-secondary small">
                        A free tool to calculate your total professional work experience accurately and instantly.
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">Quick Links</h6>
                    <ul class="list-unstyled small">
                        <li><a href="#calculator" class="text-secondary text-decoration-none">Calculator</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">About</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">Legal</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">Privacy Policy</a></li>
                        <li><a asp-controller="Home" asp-action="Terms" class="text-secondary text-decoration-none">Terms of Use</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary" />
            <p class="text-center text-secondary small mb-0">
                &copy; @DateTime.Now.Year Experience Calculator. All rights reserved.
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>